# ===== 微信小程序 =====
WX_APPID=wxf739388435fa87ee
WX_SECRET=

# ===== JWT 签名密钥 =====
# 上线时务必改成随机字符串，泄露后所有 token 都会被伪造
JWT_SECRET=daka-prod-secret-please-change-me

# ===== 服务端口 =====
# 微信云托管默认要求容器监听 80
PORT=80

# ===== 存储后端 =====
# json = 用 server/data.json（开发期 / 单机）
# mysql = 用 MySQL（生产）
STORAGE=mysql

# ===== MySQL（STORAGE=mysql 时必填） =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=daka

# ===== 文件存储 =====
# disk = 写本地 server/uploads（开发期）
# cos  = 写腾讯云对象存储 COS（生产）
STORAGE_DRIVER=cos

# ===== 腾讯云 COS（STORAGE_DRIVER=cos 时必填） =====
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
# 可选：自定义访问域名（CDN/自定义域名）；不填用默认 cos 域名
COS_PUBLIC_HOST=
