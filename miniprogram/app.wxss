/* ========== 蓝绿色主题 · 灵感：阿嚒手作 × 喜茶 ========== */
/* 主色：Teal 系列  |  强调：Cyan 系列  |  风格：大留白 · 圆角 · 清爽 */

page {
  background: #F0FDFA;
  font-size: 28rpx;
  color: #1A1A2E;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(13, 148, 136, .06);
}

/* ---------- 布局工具 ---------- */
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }

/* ---------- 按钮 ---------- */
.btn {
  background: #0D9488;
  color: #fff;
  border-radius: 16rpx;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
  line-height: 1.4;
  text-align: center;
  letter-spacing: 1rpx;
  transition: opacity .2s;
}
.btn:active { opacity: .85; }
.btn-line {
  background: transparent;
  color: #0D9488;
  border: 2rpx solid #0D9488;
}
.btn-mini {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border-radius: 20rpx;
}

/* ---------- 文字 ---------- */
.muted { color: #94A3B8; font-size: 24rpx; }
.title { font-size: 34rpx; font-weight: 600; color: #1A1A2E; letter-spacing: 1rpx; }
.sub   { font-size: 26rpx; color: #64748B; }

/* ---------- 输入框 ---------- */
.input {
  background: #E2F5F0;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin: 12rpx 0;
  color: #1A1A2E;
  font-size: 28rpx;
}

/* ---------- 头像 ---------- */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #CCFBF1;
  margin-right: 16rpx;
  overflow: hidden;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  background: #CCFBF1;
  color: #0D9488;
  margin-left: 8rpx;
}
.tag-grey {
  background: #E0F2FE;
  color: #0E7490;
}

/* ---------- 分隔线 ---------- */
.divider {
  height: 1rpx;
  background: #E2F5F0;
  margin: 18rpx 0;
}

/* ---------- 药丸标签 ---------- */
.pill {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: #CCFBF1;
  color: #0D9488;
  font-size: 24rpx;
  margin-right: 10rpx;
}

/* ---------- 完成动效：撒星星 ---------- */
.celebrate-mask {
  position: fixed;
  inset: 0;
  background: rgba(13, 148, 136, .25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.celebrate-text {
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  text-shadow: 0 4rpx 20rpx rgba(13, 148, 136, .5);
}
.star {
  position: absolute;
  font-size: 44rpx;
  animation: starFly 1.6s ease-out forwards;
}
@keyframes starFly {
  0%   { transform: translate(0, 0) scale(.4) rotate(0deg);   opacity: 1; }
  100% { transform: translate(var(--x), var(--y)) scale(1.2) rotate(360deg); opacity: 0; }
}
