page {
  background: linear-gradient(180deg, #FCFAF6 0%, #FFFDF9 48%, #FCFAF6 100%);
  font-size: 28rpx;
  color: #30261E;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.page-header {
  padding: 16rpx 4rpx 22rpx;
}

.hello {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #30261E;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #30261E;
}

.card {
  background: #FFFDF9;
  border-radius: 32rpx;
  padding: 28rpx;
  margin: 20rpx 0;
  box-shadow: 0 16rpx 42rpx rgba(233, 130, 67, .08);
  border: 1rpx solid #F0E7DC;
  box-sizing: border-box;
}

.hero-card {
  background: linear-gradient(135deg, #F2B36D 0%, #E98243 100%);
  color: #fff;
  border: 0;
  box-shadow: 0 22rpx 46rpx rgba(233, 130, 67, .24);
}

.reply-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFDF9;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 20rpx rgba(233, 130, 67, .08);
  z-index: 50;
}

.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.center { display: flex; align-items: center; justify-content: center; }
.wrap { flex-wrap: wrap; }
.gap-sm { gap: 12rpx; }
.gap { gap: 18rpx; }

.btn {
  background: linear-gradient(135deg, #F2B36D 0%, #E98243 100%);
  color: #fff;
  border-radius: 999rpx;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
  line-height: 1.4;
  text-align: center;
  letter-spacing: 1rpx;
  box-shadow: 0 12rpx 26rpx rgba(233, 130, 67, .24);
  transition: opacity .2s;
}
.btn:active { opacity: .85; }
.btn-line {
  background: #FBEFE4;
  color: #E98243;
  border: 2rpx solid #F0E7DC;
  box-shadow: none;
}
.btn-mini {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}
.btn-danger {
  color: #EF4444;
  border-color: #FECACA;
  background: #FFF1F2;
}

.muted { color: #988878; font-size: 24rpx; }
.title { font-size: 34rpx; font-weight: 700; color: #30261E; letter-spacing: 1rpx; }
.sub   { font-size: 26rpx; color: #988878; }
.white-muted { color: rgba(255, 255, 255, .76); font-size: 24rpx; }

.input {
  background: #FFFDF9;
  border: 1rpx solid #F0E7DC;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  margin: 12rpx 0;
  color: #30261E;
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 88rpx;
  box-sizing: border-box;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FBEFE4, #F2B36D);
  margin-right: 16rpx;
  overflow: hidden;
}

.avatar-sm {
  width: 52rpx;
  height: 52rpx;
  margin-right: -12rpx;
  border: 4rpx solid #fff;
}

.icon-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #FBEFE4;
  color: #E98243;
  font-size: 36rpx;
  font-weight: 800;
  margin-right: 18rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #FBEFE4;
  color: #E98243;
  margin-left: 8rpx;
}
.tag-grey {
  background: #F7F1EA;
  color: #988878;
}

.divider {
  height: 1rpx;
  background: #F0E7DC;
  margin: 18rpx 0;
}

.pill {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #FBEFE4;
  color: #E98243;
  font-size: 24rpx;
  margin-right: 10rpx;
}

.stat-grid {
  display: flex;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  background: #FBEFE4;
  border-radius: 24rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}

.stat-num {
  font-size: 34rpx;
  color: #30261E;
  font-weight: 800;
}

.task-card {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.progress-ring {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: conic-gradient(#E98243 0deg, #E98243 var(--progress, 260deg), #FBEFE4 var(--progress, 260deg), #FBEFE4 360deg);
  position: relative;
}

.progress-ring::after {
  content: "";
  position: absolute;
  inset: 14rpx;
  border-radius: 50%;
  background: #FFFDF9;
}

.progress-check {
  position: relative;
  z-index: 1;
  color: #E98243;
  font-size: 46rpx;
  font-weight: 900;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.calendar-day {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  font-size: 22rpx;
  color: #988878;
  margin: 7rpx 14rpx 7rpx 0;
}

.calendar-day.done {
  background: #FBEFE4;
  color: #E98243;
}

.calendar-day.today {
  background: #E98243;
  color: #fff;
  box-shadow: 0 10rpx 20rpx rgba(233, 130, 67, .24);
}

.celebrate-mask {
  position: fixed;
  inset: 0;
  background: rgba(233, 130, 67, .22);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.celebrate-text {
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  text-shadow: 0 4rpx 20rpx rgba(233, 130, 67, .5);
}
.star {
  position: absolute;
  font-size: 44rpx;
  animation: starFly 1.6s ease-out forwards;
}
@keyframes starFly {
  0%   { transform: translate(0, 0) scale(.4) rotate(0deg);   opacity: 1; }
  100% { transform: translate(var(--x), var(--y)) scale(1.2) rotate(360deg); opacity: 0; }
}
