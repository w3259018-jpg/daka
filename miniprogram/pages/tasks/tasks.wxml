<view class="page today-page">
  <view class="page-header row between">
    <view>
      <view class="hello">今天，完成一件小事</view>
      <view class="sub">{{todayText}} · 你好，{{user.nickname || '打卡成员'}}</view>
    </view>
    <view class="icon-badge center">今</view>
  </view>

  <view class="card hero-card today-hero">
    <view class="white-muted">今日剩余</view>
    <view class="hero-num">{{remainingCount}}</view>
    <view class="white-muted">只显示你的待办和完成进度，其他成员不可见。</view>
    <view class="btn hero-btn" catchtap="openFirstPending">
      {{primaryTask ? '继续完成' : '暂无待办'}}
    </view>
  </view>

  <view class="card" wx:if="{{primaryTask}}">
    <view class="row between">
      <view>
        <view class="section-title">正在进行</view>
        <view class="muted">{{primaryTask.currentTitle}}</view>
      </view>
      <view class="tag">{{primaryTask.roleText}}</view>
    </view>
    <view class="task-focus" bindtap="openTask" data-id="{{primaryTask.id}}">
      <view class="icon-badge center">打</view>
      <view class="task-main">
        <view class="task-name">{{primaryTask.name}}</view>
        <view class="muted">{{primaryTask.dateText}}</view>
        <view class="progress-track">
          <view class="progress-fill" style="width:{{primaryTask.item_count ? primaryTask.my_completed_count * 100 / primaryTask.item_count : 0}}%;"></view>
        </view>
      </view>
      <view class="btn btn-mini" catchtap="openCurrent" data-item-id="{{primaryTask.current_item.id}}">去打卡</view>
    </view>
  </view>

  <view class="card" wx:else>
    <view class="section-title">正在进行</view>
    <view class="empty-text">今天没有待打卡内容。你可以加入新任务，或等待管理员发布下一项打卡。</view>
  </view>

  <view class="card">
    <view class="row between">
      <view>
        <view class="section-title">本周节奏</view>
        <view class="muted">基于你的个人完成次数生成</view>
      </view>
      <view class="tag">{{completedCount}} 个计划已完成</view>
    </view>
    <view class="week-row">
      <view wx:for="{{week}}" wx:key="key" class="week-dot {{item.done ? 'done' : ''}} {{item.today ? 'today' : ''}}">
        <view>{{item.label}}</view>
        <text>{{item.day}}</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{pending.length}}">
    <view class="section-title">今日待办</view>
    <view wx:for="{{pending}}" wx:key="id" class="task-card task-list-card" bindtap="openTask" data-id="{{item.id}}">
      <view class="icon-badge center">待</view>
      <view class="task-main">
        <view class="task-name">{{item.name}}<text class="tag">{{item.progressText}}</text></view>
        <view class="muted">{{item.currentTitle}}</view>
      </view>
      <view class="btn btn-mini" catchtap="openCurrent" data-item-id="{{item.current_item.id}}">继续</view>
    </view>
  </view>

  <view class="card" wx:if="{{managed.length}}">
    <view class="row between">
      <view>
        <view class="section-title">我管理的任务</view>
        <view class="muted">进入详情可查看管理员看板</view>
      </view>
      <view class="tag">{{managed.length}} 个</view>
    </view>
    <view wx:for="{{managed}}" wx:key="id" class="managed-row" bindtap="openTask" data-id="{{item.id}}">
      <view>
        <view class="task-name">{{item.name}}</view>
        <view class="muted">本人进度 {{item.progressText}}</view>
      </view>
      <view class="muted">查看</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">开始一个计划</view>
    <view class="quick-actions">
      <view class="btn btn-line" bindtap="toggleJoin">{{showJoin ? '收起邀请码' : '输入邀请码加入'}}</view>
      <view class="btn" bindtap="openCreate">新建打卡任务</view>
    </view>
    <view wx:if="{{showJoin}}" class="join-box">
      <input class="input" placeholder="请输入管理员分享的邀请码" value="{{joinCode}}" bindinput="onInput" data-k="joinCode" />
      <view class="btn" bindtap="join">下一步</view>
    </view>
  </view>
</view>
<privacy-popup class="privacy-popup" />
