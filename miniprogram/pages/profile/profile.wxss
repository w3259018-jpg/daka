.profile-hero {
  padding: 36rpx 32rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.avatar-lg {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FBEFE4, #F2B36D);
  border: 4rpx solid rgba(255, 253, 249, .72);
}

.avatar-empty {
  color: #E98243;
  font-size: 32rpx;
  font-weight: 800;
}

.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.nick-input {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  padding: 8rpx 0;
  min-height: 48rpx;
}

.profile-stats {
  margin-top: 20rpx;
}

.records-entry {
  margin-top: 22rpx;
}

.privacy-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #FBEFE4;
  color: #E98243;
  font-size: 24rpx;
  line-height: 1.6;
}

.settings-title {
  margin-bottom: 8rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}
