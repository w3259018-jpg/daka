<view class="page profile-page">
  <view class="card hero-card row profile-hero">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="设置头像">
      <image wx:if="{{user.avatar}}" class="avatar avatar-lg" src="{{user.avatar}}" mode="aspectFill"></image>
      <view wx:else class="avatar avatar-lg center avatar-empty">为一</view>
    </button>
    <view class="profile-main">
      <input
        type="nickname"
        class="nick-input"
        value="{{user.nickname}}"
        placeholder="点击设置昵称"
        placeholder-style="color:rgba(255,255,255,.72);"
        bindchange="onNicknameChange"
        bindblur="onNicknameChange" />
      <view class="white-muted">账号资料仅用于你参与的打卡任务。</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">我的概览</view>
    <view class="stat-grid profile-stats">
      <view class="stat-item">
        <view class="stat-num">{{overview.tasks}}</view>
        <view class="muted">参与任务</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{overview.completed}}</view>
        <view class="muted">本人完成</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{overview.managed}}</view>
        <view class="muted">管理任务</view>
      </view>
    </view>
    <view class="btn btn-line records-entry" bindtap="goRecords">查看我的记录</view>
  </view>

  <view class="card">
    <view class="section-title">隐私边界</view>
    <view class="privacy-note">
      你的打卡记录仅你本人和对应任务管理员可查看，同任务其他成员不可查看你的完成状态、心得或个人记录。
    </view>
  </view>

  <view class="card">
    <view class="section-title settings-title">设置</view>
    <view class="setting-row" bindtap="goPrivacy">
      <view>隐私政策</view>
      <text class="muted">查看</text>
    </view>
    <view class="divider"></view>
    <view class="setting-row" bindtap="goAgreement">
      <view>用户协议</view>
      <text class="muted">查看</text>
    </view>
  </view>
</view>
<privacy-popup class="privacy-popup" />
