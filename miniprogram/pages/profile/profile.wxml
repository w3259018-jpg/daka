<view class="card row" style="padding:36rpx 32rpx;">
  <open-data type="userAvatarUrl" class="avatar avatar-lg"></open-data>
  <view style="flex:1; margin-left:20rpx;">
    <open-data type="userNickName" class="nick-input"></open-data>
    <view class="muted" style="margin-top:6rpx;">已加入 {{tasks.length}} 个任务</view>
  </view>
</view>

<view class="card" wx:if="{{tasks.length}}">
  <picker mode="selector" range="{{names}}" value="{{idx}}" bindchange="pick">
    <view class="input">{{tasks[idx].name || '请选择任务'}} ▾</view>
  </picker>
  <view class="row" style="gap:12rpx; margin-top:12rpx;">
    <picker mode="date" value="{{startDate}}" bindchange="pickStart" style="flex:1;">
      <view class="input" style="margin:0;">起：{{startDate || '不限'}}</view>
    </picker>
    <picker mode="date" value="{{endDate}}" bindchange="pickEnd" style="flex:1;">
      <view class="input" style="margin:0;">止：{{endDate || '不限'}}</view>
    </picker>
    <view class="muted" bindtap="clearDate">清除</view>
  </view>
  <view class="row between" style="margin-top:18rpx;">
    <view class="muted">勾选记录后导出</view>
    <view class="btn btn-mini" bindtap="exportNotes">导出选中</view>
  </view>
</view>

<view class="card" wx:if="{{tasks.length}}">
  <view class="title">我的打卡记录（{{filtered.length}}）</view>
  <view wx:for="{{filtered}}" wx:key="id" class="row" style="padding:20rpx 0; border-top:1rpx solid #E2F5F0;">
    <checkbox checked="{{selected[item.id]}}" bindtap="toggle" data-id="{{item.id}}" style="margin-right:12rpx;" color="#0D9488" />
    <view style="flex:1;" bindtap="goPost" data-id="{{item.post_id}}">
      <view style="font-weight:500;">{{item.item_title}}</view>
      <view class="muted" style="margin:8rpx 0;">{{item.date}}</view>
      <view class="sub" style="white-space:pre-wrap; line-height:1.7;">{{item.note}}</view>
      <view class="muted" style="margin-top:8rpx;">♥ {{item.likes}} · 💬 {{item.comments}}</view>
    </view>
  </view>
  <view wx:if="{{!filtered.length}}" class="muted" style="text-align:center; padding:24rpx 0;">暂无记录</view>
</view>

<view class="card" wx:if="{{!tasks.length}}"><view class="muted" style="text-align:center; padding:24rpx 0;">先去「任务」加入或创建任务</view></view>

<view class="card" style="margin-top:20rpx;">
  <view class="title" style="margin-bottom:20rpx;">关于</view>
  <view class="row between" style="padding:20rpx 0; border-top:1rpx solid #E2F5F0;" bindtap="goPrivacy">
    <view>隐私政策</view>
    <text class="muted">›</text>
  </view>
  <view class="row between" style="padding:20rpx 0; border-top:1rpx solid #E2F5F0;" bindtap="goAgreement">
    <view>用户协议</view>
    <text class="muted">›</text>
  </view>
</view>
