<view wx:if="{{post}}">
  <view class="card">
    <view class="row">
      <view class="avatar"></view>
      <view style="flex:1;">
        <view style="font-weight:500;">{{post.nickname}}<text class="tag {{post.source==='manual'?'tag-grey':''}}">{{post.source==='checkin'?'打卡心得':'自由分享'}}</text></view>
      </view>
    </view>
    <view style="margin-top:16rpx; white-space:pre-wrap; line-height:1.7;">{{post.content}}</view>
    <view class="row" style="margin-top:18rpx; gap:28rpx;">
      <view bindtap="like" class="muted">{{post.liked ? '♥' : '♡'}} {{post.likes}}</view>
      <view class="muted">💬 {{post.comments}}</view>
    </view>
  </view>

  <view class="card">
    <view class="title">评论</view>
    <view wx:for="{{tree}}" wx:key="id" wx:for-item="c" style="padding:20rpx 0; border-top:1rpx solid #E2F5F0;">
      <view class="row">
        <view class="avatar"></view>
        <view style="flex:1;">
          <view class="sub" style="font-weight:500;">{{c.nickname}}</view>
          <view style="margin-top:6rpx; line-height:1.6;">{{c.content}}</view>
          <view class="muted" style="margin-top:6rpx;" bindtap="setReply" data-id="{{c.id}}" data-name="{{c.nickname}}">回复</view>
        </view>
      </view>
      <view wx:for="{{c.replies}}" wx:key="id" wx:for-item="r" style="margin-left:88rpx; padding:12rpx 0;">
        <view class="sub" style="font-weight:500;">{{r.nickname}} <text class="muted">回复</text></view>
        <view style="margin-top:4rpx; line-height:1.6;">{{r.content}}</view>
      </view>
    </view>
    <view wx:if="{{!tree.length}}" class="muted" style="padding:24rpx 0; text-align:center;">沙发还空着</view>
  </view>
</view>

<view class="card row" style="position:sticky; bottom:0; background:#fff; border-radius:0; margin:0; padding:20rpx 24rpx; box-shadow:0 -4rpx 16rpx rgba(13,148,136,.08);">
  <input class="input" style="flex:1; margin:0 12rpx 0 0;" placeholder="{{parentId ? '回复 ' + parentName : '说点什么…'}}" value="{{text}}" bindinput="onInput" />
  <view wx:if="{{parentId}}" class="muted" bindtap="cancelReply" style="margin-right:12rpx;">取消</view>
  <view class="btn btn-mini" bindtap="send">发送</view>
</view>
