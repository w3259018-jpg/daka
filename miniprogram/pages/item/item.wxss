.item-sub {
  margin-top: 8rpx;
}

.video-player {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.audio-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #FBEFE4;
}

.audio-tip {
  margin-top: 14rpx;
}

.audio-progress {
  margin-top: 22rpx;
}

.audio-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 34rpx;
  color: #8F8278;
  font-size: 24rpx;
  line-height: 34rpx;
}

.audio-slider {
  margin: 4rpx 0 0;
}

.audio-speed-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.audio-speed {
  min-width: 88rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(233, 130, 67, 0.28);
  border-radius: 999rpx;
  color: #A66A3A;
  font-size: 24rpx;
  line-height: 48rpx;
  text-align: center;
  background: rgba(255, 253, 249, 0.72);
}

.audio-speed-active {
  border-color: #E98243;
  color: #FFFFFF;
  background: linear-gradient(135deg, #F2B36D, #E98243);
}

.note-input {
  min-height: 220rpx;
  margin-top: 16rpx;
}

.privacy-note {
  margin: 18rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #FBEFE4;
  color: #E98243;
  font-size: 24rpx;
  line-height: 1.6;
}

.submitted-note {
  margin-top: 12rpx;
  line-height: 1.65;
}
