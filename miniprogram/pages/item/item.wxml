<view class="page item-page" wx:if="{{item}}">
  <view class="card">
    <view class="title">{{item.title}}</view>
    <view class="muted item-sub">{{item.mediaText}} · {{watched ? '已确认观看' : '请先播放'}}</view>

    <video wx:if="{{item.media_type === 'video'}}" src="{{mediaSrc}}" controls bindplay="onVideoPlay" binderror="onVideoError" class="video-player" />

    <view wx:else class="audio-card">
      <view class="row gap-sm">
        <view class="btn btn-line" bindtap="playAudio">播放</view>
        <view class="btn btn-line" bindtap="pauseAudio">暂停</view>
      </view>
      <view class="audio-progress">
        <view class="audio-time-row">
          <text>{{audioCurrentText}}</text>
          <text>{{audioDurationText}}</text>
        </view>
        <slider
          class="audio-slider"
          value="{{audioProgress}}"
          min="0"
          max="100"
          step="0.1"
          block-size="18"
          activeColor="#E98243"
          backgroundColor="#F5D8C4"
          bindchanging="onAudioProgressChanging"
          bindchange="onAudioProgressChange"
        />
      </view>
      <view class="audio-speed-row">
        <view
          wx:for="{{audioSpeedOptions}}"
          wx:key="*this"
          wx:for-item="speed"
          class="audio-speed {{audioPlaybackRate === speed ? 'audio-speed-active' : ''}}"
          data-rate="{{speed}}"
          bindtap="setAudioPlaybackRate"
        >{{speed}}x</view>
      </view>
      <view class="muted audio-tip">音频会从服务器加载，请保持网络畅通。</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">我的心得</view>
    <textarea class="input note-input" placeholder="听完或看完后，写下你的感受" value="{{note}}" bindinput="onNote" disabled="{{submitted}}" />
    <view class="privacy-note">
      本次心得不会向其他成员展示，仅你本人和本任务管理员可查看。
    </view>
    <view class="btn" wx:if="{{!submitted}}" bindtap="submit">提交打卡</view>
    <view class="muted submitted-note" wx:else>已提交：{{note}}</view>
  </view>
</view>

<view wx:if="{{celebrating}}" class="celebrate-mask">
  <view wx:for="{{stars}}" wx:key="id" class="star" style="left:{{item.l}}; top:{{item.t}}; --x:{{item.x}}; --y:{{item.y}}; color:{{item.c}};">{{item.ch}}</view>
  <view class="celebrate-text">完成打卡</view>
</view>
<login-popup show="{{showLoginPopup}}" bind:profilesuccess="onProfileSuccess" bind:skipsuccess="onProfileSkip" />
