<view class="card">
  <picker mode="selector" range="{{names}}" value="{{idx}}" bindchange="pick">
    <view class="input">{{tasks[idx].name || '请选择任务'}} ▾</view>
  </picker>
</view>

<view class="card" wx:if="{{!tasks.length}}"><view class="muted">先去「任务」加入或创建任务</view></view>

<view class="card" wx:if="{{tasks.length}}">
  <view class="title">打卡排行榜</view>
  <view wx:for="{{list}}" wx:key="user_id" class="row" style="padding:18rpx 0; border-top:1rpx solid #eee;">
    <view style="width:60rpx; font-weight:600; color:{{index<3 ? '#e8a500' : '#888'}};">{{index+1}}</view>
    <view class="avatar"></view>
    <view style="flex:1;">{{item.real_name || item.nickname}}</view>
    <view class="muted">打卡 {{item.cnt}} 次</view>
  </view>
  <view class="muted" wx:if="{{!list.length}}">暂无成员</view>
</view>
