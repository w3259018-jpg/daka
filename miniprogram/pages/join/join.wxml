<view class="page">
  <view class="page-header">
    <view class="hello">加入「{{taskName}}」</view>
    <view class="sub">填写入组信息后即可加入任务</view>
  </view>

  <view class="card">
    <view class="privacy-note">
      加入后，任务管理员可查看你在本任务中的完成状态和打卡记录；其他成员不可查看。
    </view>
    <input class="input" placeholder="姓名" value="{{realName}}" bindinput="onInput" data-k="realName" />
    <picker range="{{genders}}" value="{{gIdx}}" bindchange="pickG">
      <view class="input">性别：{{genders[gIdx]}}</view>
    </picker>
    <input class="input" type="number" placeholder="年龄" value="{{age}}" bindinput="onInput" data-k="age" />
    <view class="btn join-btn" bindtap="submit">确认加入</view>
  </view>
</view>
<login-popup show="{{showLoginPopup}}" bind:profilesuccess="onProfileSuccess" bind:skipsuccess="onProfileSkip" />
