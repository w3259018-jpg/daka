.task-detail-page {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.35;
}

.hero-role {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .2);
  color: #fff;
  font-size: 24rpx;
}

.hero-stats,
.admin-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}

.hero-stats {
  grid-template-columns: repeat(3, 1fr);
}

.hero-stats > view {
  padding: 20rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .16);
  text-align: center;
}

.hero-num {
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
}

.progress-track {
  height: 14rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #F0E7DC;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  min-width: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F2B36D 0%, #E98243 100%);
}

.current-item,
.item-row,
.member-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0E7DC;
}

.current-item {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 0;
  border-radius: 28rpx;
  background: #FBEFE4;
}

.item-row:last-child,
.member-row:last-child {
  border-bottom: 0;
}

.current-main,
.member-main {
  flex: 1;
  min-width: 0;
}

.task-name {
  color: #30261E;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.admin-card {
  border-color: #F3D7BF;
}

.admin-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.share-btn {
  margin: 0;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
}

.publish-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: #FFF8F0;
}

.media-path {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.publish-btn,
.dissolve-btn {
  margin-top: 20rpx;
}

.member-avatar {
  width: 68rpx;
  height: 68rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  background: #FBEFE4;
  color: #E98243;
  font-weight: 900;
}

.empty-text {
  padding: 28rpx 0 6rpx;
  color: #988878;
  font-size: 26rpx;
  line-height: 1.7;
}

.fixed-action {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.bottom-space {
  height: 120rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(48, 38, 30, .34);
}

.record-modal {
  width: 100%;
  max-height: 72vh;
  overflow-y: auto;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #FFFDF9;
  box-sizing: border-box;
}

.record-row {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #FBEFE4;
}

.record-note {
  margin-top: 12rpx;
  color: #30261E;
  font-size: 26rpx;
  line-height: 1.65;
}
