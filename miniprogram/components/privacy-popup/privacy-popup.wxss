.pp-mask {
  position: fixed;
  inset: 0;
  background: rgba(48, 38, 30, .52);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.pp-card {
  width: 600rpx;
  background: #FFFDF9;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 28rpx;
  box-shadow: 0 32rpx 64rpx rgba(233, 130, 67, .18);
  box-sizing: border-box;
}

.pp-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #30261E;
  text-align: center;
  margin-bottom: 24rpx;
}

.pp-content {
  font-size: 26rpx;
  color: #988878;
  line-height: 1.7;
  margin-bottom: 32rpx;
}

.pp-link {
  color: #E98243;
  text-decoration: underline;
}

.pp-actions {
  display: flex;
  gap: 20rpx;
}

.pp-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  line-height: 1.4;
  border: none;
}
.pp-btn::after { border: none; }

.pp-btn-cancel {
  background: #FBEFE4;
  color: #988878;
}
.pp-btn-cancel:active { opacity: .85; }

.pp-btn-ok {
  background: linear-gradient(135deg, #F2B36D 0%, #E98243 100%);
  color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(233, 130, 67, .26);
}
.pp-btn-ok:active { opacity: .9; }
